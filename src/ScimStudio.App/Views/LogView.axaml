<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScimStudio.App.ViewModels"
             xmlns:c="using:ScimStudio.App.Controls"
             xmlns:l="using:ScimStudio.App.Localization"
             x:Class="ScimStudio.App.Views.LogView"
             x:DataType="vm:LogViewModel">

    <Grid ColumnDefinitions="*,1.3*">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="title" Text="{l:Tr log.title}" />
                            <TextBlock Classes="faint small" TextWrapping="Wrap" Text="{l:Tr log.about}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Command="{Binding ClearCommand}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Data="{x:Static c:Icons.Trash}" Width="14" Height="14" />
                                <TextBlock Text="{l:Tr log.clear}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Search}" PlaceholderText="{l:Tr log.search}">
                            <TextBox.InnerLeftContent>
                                <c:Icon Data="{x:Static c:Icons.Search}" Width="14" Height="14" Margin="10,0,0,0"
                                        Foreground="{DynamicResource FaintTextBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ToggleButton Grid.Column="1" Classes="subtle" MinHeight="34" IsChecked="{Binding ErrorsOnly}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Data="{x:Static c:Icons.Filter}" Width="14" Height="14" />
                                <TextBlock Text="{l:Tr log.errorsOnly}" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </StackPanel>

                <Panel>
                    <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" Margin="24,40" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Text="{l:Tr log.empty}" />
                    <ListBox Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExchangeItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                    <Border Classes="method" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Method}" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono strong" Text="{Binding Status}" VerticalAlignment="Center"
                                               Classes.ok="{Binding IsSuccess}" Classes.warn="{Binding IsClientError}"
                                               Classes.bad="{Binding IsServerError}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="faint mono" FontSize="10" Text="{Binding Time}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="faint small" Text="{Binding Origin}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="faint small" Text="{Binding Duration}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </DockPanel>
        </Border>

        <Panel Grid.Column="1">
            <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" Spacing="10"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <c:Icon Data="{x:Static c:Icons.Activity}" Width="34" Height="34" Foreground="{DynamicResource FaintTextBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{l:Tr log.selectHint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" />
            </StackPanel>

            <DockPanel Margin="24,20,24,16" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Panel DockPanel.Dock="Top" DataContext="{Binding Selected}">
                    <StackPanel Spacing="8" x:DataType="vm:ExchangeItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="method">
                                <TextBlock Text="{Binding Method}" />
                            </Border>
                            <TextBlock Classes="mono strong" Text="{Binding StatusLine}" VerticalAlignment="Center"
                                       Classes.ok="{Binding IsSuccess}" Classes.warn="{Binding IsClientError}"
                                       Classes.bad="{Binding IsServerError}" />
                            <TextBlock Classes="faint small" Text="{Binding Duration}" VerticalAlignment="Center" />
                        </StackPanel>
                        <SelectableTextBlock Classes="mono" Text="{Binding Url}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="faint small" Text="{Binding Time}" />
                            <TextBlock Classes="faint small" Text="·" />
                            <TextBlock Classes="faint small" Text="{Binding Origin}" />
                        </StackPanel>
                        <Border Classes="banner" IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <SelectableTextBlock Text="{Binding Failure}" />
                        </Border>
                    </StackPanel>
                </Panel>

                <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,4" ItemSpacing="8" LineSpacing="8">
                    <Button Command="{Binding CopyCurlCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Data="{x:Static c:Icons.Terminal}" Width="14" Height="14" />
                            <TextBlock Text="{l:Tr log.copyCurl}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyPowerShellCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Data="{x:Static c:Icons.Terminal}" Width="14" Height="14" />
                            <TextBlock Text="{l:Tr log.copyPowerShell}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="subtle" Command="{Binding CopyUrlCommand}" Content="{l:Tr log.copyUrl}" />
                    <Button Classes="subtle" Command="{Binding CopyResponseCommand}" Content="{l:Tr log.copyResponse}" />
                </WrapPanel>

                <TabControl SelectedIndex="{Binding DetailTab}">
                    <TabItem Header="{l:Tr log.request}">
                        <ScrollViewer>
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="eyebrow" Text="{l:Tr log.headers}" />
                                <Border Classes="well">
                                    <SelectableTextBlock Classes="mono" Text="{Binding Selected.RequestHeaders, FallbackValue=''}"
                                                         TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Classes="eyebrow" Text="{l:Tr log.body}"
                                           IsVisible="{Binding Selected.HasRequestBody, FallbackValue=False}" />
                                <Border Classes="well" IsVisible="{Binding Selected.HasRequestBody, FallbackValue=False}">
                                    <c:JsonText Classes="mono" Json="{Binding Selected.RequestBody, FallbackValue=''}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{l:Tr log.response}">
                        <ScrollViewer>
                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                <TextBlock Classes="eyebrow" Text="{l:Tr log.headers}" />
                                <Border Classes="well">
                                    <SelectableTextBlock Classes="mono" Text="{Binding Selected.ResponseHeaders, FallbackValue=''}"
                                                         TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Classes="eyebrow" Text="{l:Tr log.body}"
                                           IsVisible="{Binding Selected.HasResponseBody, FallbackValue=False}" />
                                <Border Classes="well" IsVisible="{Binding Selected.HasResponseBody, FallbackValue=False}">
                                    <c:JsonText Classes="mono" Json="{Binding Selected.ResponseBody, FallbackValue=''}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Panel>
    </Grid>
</UserControl>
